-- Penyimpanan lokal (offline-first). Prediksi disimpan sebagai JSON (semua skor kelas per model).

CREATE TABLE capture (
    id TEXT NOT NULL PRIMARY KEY,
    dataset TEXT NOT NULL,
    fish_code TEXT NOT NULL,
    species TEXT NOT NULL,
    label TEXT NOT NULL,
    market TEXT NOT NULL,
    notes TEXT NOT NULL,
    captured_at INTEGER NOT NULL,
    photo_path TEXT NOT NULL,
    width INTEGER NOT NULL,
    height INTEGER NOT NULL,
    sha256 TEXT NOT NULL,
    eye_path TEXT NOT NULL,
    cx REAL NOT NULL,
    cy REAL NOT NULL,
    r REAL NOT NULL,
    adjusted INTEGER NOT NULL,
    sharpness REAL,
    brightness REAL,
    predictions_json TEXT NOT NULL,
    sync_state TEXT NOT NULL DEFAULT 'PENDING',
    sync_error TEXT,
    -- 1 bila label diubah setelah terunggah -> perlu diperbarui di Supabase
    label_dirty INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX capture_time ON capture(captured_at);

CREATE TABLE scan (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    photo_path TEXT NOT NULL,
    width INTEGER NOT NULL,
    height INTEGER NOT NULL,
    sha256 TEXT NOT NULL,
    eye_path TEXT,
    cx REAL,
    cy REAL,
    r REAL,
    created_at INTEGER NOT NULL,
    predictions_json TEXT NOT NULL
);

-- Antrean penghapusan di Supabase untuk foto yang dihapus setelah terunggah.
CREATE TABLE remote_delete (
    id TEXT NOT NULL PRIMARY KEY,
    raw_path TEXT NOT NULL,
    eye_path TEXT NOT NULL
);

allCaptures:
SELECT * FROM capture ORDER BY captured_at DESC;

captureById:
SELECT * FROM capture WHERE id = ?;

pendingCaptures:
SELECT * FROM capture WHERE sync_state != 'SYNCED' OR label_dirty = 1 ORDER BY captured_at;

countSynced:
SELECT COUNT(*) FROM capture WHERE sync_state = 'SYNCED' AND label_dirty = 0;

countPending:
SELECT COUNT(*) FROM capture WHERE sync_state != 'SYNCED' OR label_dirty = 1;

upsertCapture:
INSERT OR REPLACE INTO capture VALUES ?;

updateLabel:
UPDATE capture SET label = :label, label_dirty = CASE WHEN sync_state = 'SYNCED' THEN 1 ELSE label_dirty END
WHERE id = :id;

markSynced:
UPDATE capture SET sync_state = 'SYNCED', sync_error = NULL, label_dirty = 0 WHERE id = ?;

markFailed:
UPDATE capture SET sync_state = CASE WHEN sync_state = 'SYNCED' THEN 'SYNCED' ELSE 'FAILED' END,
sync_error = :error WHERE id = :id;

deleteCapture:
DELETE FROM capture WHERE id = ?;

recentSpecies:
SELECT species FROM capture GROUP BY species ORDER BY MAX(captured_at) DESC LIMIT 8;

allScans:
SELECT * FROM scan ORDER BY created_at DESC;

scanById:
SELECT * FROM scan WHERE id = ?;

insertScan:
INSERT INTO scan (photo_path, width, height, sha256, eye_path, cx, cy, r, created_at, predictions_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

deleteScan:
DELETE FROM scan WHERE id = ?;

queueRemoteDelete:
INSERT OR REPLACE INTO remote_delete VALUES ?;

remoteDeletes:
SELECT * FROM remote_delete;

doneRemoteDelete:
DELETE FROM remote_delete WHERE id = ?;
