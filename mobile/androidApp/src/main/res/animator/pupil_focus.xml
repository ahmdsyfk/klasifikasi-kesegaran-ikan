<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="sequentially">
    <set>
        <objectAnimator android:propertyName="scaleX" android:duration="260" android:valueFrom="1" android:valueTo="0.7" android:interpolator="@android:interpolator/fast_out_slow_in" />
        <objectAnimator android:propertyName="scaleY" android:duration="260" android:valueFrom="1" android:valueTo="0.7" android:interpolator="@android:interpolator/fast_out_slow_in" />
    </set>
    <set>
        <objectAnimator android:propertyName="scaleX" android:duration="320" android:valueFrom="0.7" android:valueTo="1" android:interpolator="@android:interpolator/overshoot" />
        <objectAnimator android:propertyName="scaleY" android:duration="320" android:valueFrom="0.7" android:valueTo="1" android:interpolator="@android:interpolator/overshoot" />
    </set>
</set>
